{
  "version": 2,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/celestrak/:group", "destination": "https://celestrak.org/NORAD/elements/gp.php?GROUP=:group&FORMAT=tle" },
    { "source": "/api/adsblol/mil", "destination": "https://api.adsb.lol/v2/mil" },
    { "source": "/api/adsblol/:path*", "destination": "https://api.adsb.lol/v2/:path*" },
    { "source": "/api/adsbdb/type/:hex", "destination": "https://api.adsbdb.com/v0/aircraft/:hex" },
    { "source": "/api/adsbdb/route/:cs", "destination": "https://api.adsbdb.com/v0/callsign/:cs" },
    { "source": "/api/adsbdb/:path*", "destination": "https://api.adsbdb.com/v0/:path*" },
    { "source": "/api/tomtom/flow/:z/:x/:y.pbf", "destination": "/api/tomtom/flow?z=:z&x=:x&y=:y" },
    { "source": "/api/launches", "destination": "https://ll.thespacedevs.com/2.2.0/launch/upcoming/?limit=10" },
    { "source": "/cesium/:path*", "destination": "/divines-eye/cesium/:path*" },
    { "source": "/models/:path*", "destination": "/divines-eye/models/:path*" },
    { "source": "/assets/:file([^/]+)", "destination": "/divines-eye/assets/:file" },
    { "source": "/:file((?:logo|pin|location|mic|visual-presets)\\.svg)", "destination": "/divines-eye/:file" }
  ]
}
