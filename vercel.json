{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/overpass.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https: http://127.0.0.1:* http://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://*.cesium.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https: http:; connect-src 'self' data: blob: https: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* wss:; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-ancestors 'self';" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/celestrak/:group", "destination": "https://celestrak.org/NORAD/elements/gp.php?GROUP=:group&FORMAT=tle" },
    { "source": "/api/adsblol/mil", "destination": "https://api.adsb.lol/v2/mil" },
    { "source": "/api/adsblol/:path*", "destination": "https://api.adsb.lol/v2/:path*" },
    { "source": "/api/adsbdb/type/:hex", "destination": "/api/adsbdb?type=:hex" },
    { "source": "/api/adsbdb/route/:cs", "destination": "/api/adsbdb?route=:cs" },
    { "source": "/api/tomtom/flow/:z/:x/:y.pbf", "destination": "/api/tomtom/flow?z=:z&x=:x&y=:y" },
    { "source": "/api/cctv/frame/:path*", "destination": "/api/cctv?path=frame&id=:path*" },
    { "source": "/api/cctv/media/:path*", "destination": "/api/cctv?path=media&id=:path*" },
    { "source": "/api/cctv/:path*", "destination": "/api/cctv?path=:path*" },
    { "source": "/api/radio/stations", "destination": "/api/radio" },
    { "source": "/api/radio/:path*", "destination": "/api/radio" },
    { "source": "/api/firms/:path*", "destination": "/api/firms?path=:path*" },
    { "source": "/api/firms", "destination": "/api/firms" },
    { "source": "/api/launches", "destination": "https://ll.thespacedevs.com/2.2.0/launch/upcoming/?limit=10" },
    { "source": "/cesium/:path*", "destination": "/divines-eye/cesium/:path*" },
    { "source": "/models/:path*", "destination": "/divines-eye/models/:path*" },
    { "source": "/assets/:file([^/]+)", "destination": "/divines-eye/assets/:file" },
    { "source": "/:file((?:logo|pin|location|mic|visual-presets)\\.svg)", "destination": "/divines-eye/:file" }
  ]
}
